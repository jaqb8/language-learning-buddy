{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "10xdevs-project",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
  },
  "env": {
    "staging": {
      "name": "language-learning-buddy-staging",
      "vars": {
        "SUPABASE_URL": "https://supabase.jaqblab.online",
        "USE_MOCKS": false,
        "RATE_LIMIT_MAX_REQUESTS": 10,
        "RATE_LIMIT_WINDOW_MS": 60000,
        "PUBLIC_ENV_NAME": "integration",
        "AI_MODEL": "x-ai/grok-4.3",
        "AI_TEMPERATURE": "0.3",
        "AI_MAX_TOKENS": "1000",
      },
    },
    "production": {
      "name": "10xdevs-project",
      "vars": {
        "SUPABASE_URL": "https://jyllkxpxiimsktbzhtvr.supabase.co",
        "USE_MOCKS": false,
        "RATE_LIMIT_MAX_REQUESTS": 10,
        "RATE_LIMIT_WINDOW_MS": 60000,
        "PUBLIC_ENV_NAME": "production",
        "AI_MODEL": "x-ai/grok-4.3",
        "AI_TEMPERATURE": "0.3",
        "AI_MAX_TOKENS": "1000",
      },
    },
  },
  "preview_urls": true,
}
